# Public origin used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:4317

# Only "demo" exists. Real providers are not implemented (see README).
PAYMENT_PROVIDER=demo

# Where demo orders are written. Falls back to memory if not writable.
ORDER_STORE_PATH=.data/orders.json

# Optional: let an OpenAI-compatible model phrase help desk answers.
# Leave empty to use the built-in, data-grounded assistant only.
ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
# ASSISTANT_LLM_MODEL=gpt-4o-mini
